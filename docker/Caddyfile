# Caddy in front of the Cross-Com server's HTTP side, giving it HTTPS (docker/compose.https.yaml).
#
# CROSSCOM_DOMAIN is the server's domain; its DNS A record points at this machine, and ports 80
# and 443 reach it. Caddy gets the certificate itself, from Let's Encrypt over port 80.
#
# Passwords (POST /accounts, POST /api/login) are taken over HTTPS only. Port 80 still answers
# what carries none, over plain HTTP: the game asks for its online config there and can't do
# HTTPS, the in-game overlay reads the API without TLS, the client DLL sends players' logs
# (POST /api/logs, up to 4 MiB; the server takes them only from players' own addresses), and it
# and the launcher report their routers and test them (POST /api/forward and /api/reach, small).
{
	# Port 80 is set out below rather than redirecting everything to HTTPS.
	auto_https disable_redirects
}

{$CROSSCOM_DOMAIN} {
	reverse_proxy server:80
}

# Every name and address on port 80: the game asks by whatever address the player set up.
# Let's Encrypt's challenges are answered here too, before these routes.
:80 {
	@plain {
		method GET HEAD
		path /OnlineConfigService.svc/GetOnlineConfig /api/*
		not path /api/login
	}
	handle @plain {
		reverse_proxy server:80
	}
	@logs {
		method POST
		path /api/logs
	}
	handle @logs {
		request_body {
			max_size 5MB
		}
		reverse_proxy server:80
	}
	@reach {
		method POST
		path /api/forward /api/reach
	}
	handle @reach {
		request_body {
			max_size 1KB
		}
		reverse_proxy server:80
	}
	handle {
		redir https://{$CROSSCOM_DOMAIN}{uri} 308
	}
}
