// What the launcher hands the screens (ui.rs fills them in).

// One DLC pack in the game's folder.
export struct DlcRow {
    name: string,
    // "yes", "no" or "incomplete".
    state: string,
    // What it adds.
    adds: string,
}

// How things stand.
export struct InfoView {
    // The game's folder, or "".
    game-dir: string,
    // Cross-Com's client in the game: "none" (no game), "no", "yes" or "update".
    client: string,
    // Whether this launcher carries the client (a release build does).
    carries-client: bool,
    // The server set up, or "", and whether it's the community test network.
    server: string,
    community: bool,
    account: string,
    // The account's first letter, for the circle beside the name on Play ("?" for none).
    initial: string,
    skip-intro: bool,
    dx9: bool,
    overlay: bool,
    // F1 to F12, as 0 to 11.
    overlay-key: int,
    send-logs: bool,
    port-forwarding: bool,
    // The fewest players a Quick Match starts with (2 to 12).
    min-players: int,
    // The DLC packs (empty with no game), and what to warn about them ("" when all are there).
    dlc: [DlcRow],
    dlc-note: string,
    // Everything's set: Play can go.
    ready: bool,
}

// One of the server's news items.
export struct NewsRow {
    date: string,
    title: string,
    body: string,
    // The Ghost Feed view it's shown in ("Multiplayer"), or "".
    tag: string,
}

// A line of Play's checklist: what's checked, how it stands, and what it means. `tone` is "good",
// "warn", "bad" or "muted".
export struct CheckRow {
    label: string,
    value: string,
    tone: string,
    detail: string,
    // A button under it ("" for none): what fixes it, when the launcher can.
    action: string,
}

// A join code for the server hosted here, and where it works ("Friends on your network").
export struct CodeRow {
    place: string,
    code: string,
}

// A game profile, as Settings › Saves lists it: its name in the game, the account it's played
// with, when it was last played, whether it has campaign saves, and whether the game plays it now.
export struct ProfileRow {
    account: string,
    name: string,
    played: string,
    campaign: bool,
    current: bool,
}
