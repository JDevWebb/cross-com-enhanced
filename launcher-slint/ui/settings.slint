// The game options (with the in-game overlay and its key), sending the game's logs, the server
// (changing it, or going back to the community test network), the account and the identity that
// signs the player in to it (copied to move it to another PC, or another PC's used here), the
// connection test and port forwarding, and taking Cross-Com out of the game.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type } from "theme.slint";
import { Btn, Caps, Tag, Card, CardHead, Para, Check, Choice, Field } from "widgets.slint";
import { InfoView } from "types.slint";

export component SettingsScreen inherits Rectangle {
    in property <InfoView> info;
    in property <string> release;
    in property <string> community-name;
    in property <string> community-status;
    // The options as shown; changed => saved at once.
    in-out property <bool> skip-intro;
    in-out property <bool> dx9;
    in-out property <bool> overlay;
    in-out property <int> overlay-key;
    in-out property <bool> send-logs;
    in-out property <bool> port-forwarding;
    in property <string> options-said;
    in property <bool> options-failed;
    // The player's identity: its short form ("ABCD-EFGH"), or why it can't be read; the text
    // pasted from another PC, and (when using it would replace a different one) what to confirm.
    in property <string> identity;
    in property <string> identity-error;
    in-out property <string> identity-paste;
    in-out property <string> identity-confirm;
    in property <bool> identity-busy;
    in property <string> identity-said;
    in property <bool> identity-failed;
    // The logs: the last report, what the last sending said, and whether it's sending now.
    in property <string> logs-last;
    in property <string> logs-said;
    in property <bool> logs-sending;
    // The connection test: running, its verdict, the verdict's tone ("good", "warn", "bad") and
    // what it found.
    in property <bool> connection-testing;
    in property <string> connection-summary;
    in property <string> connection-tone;
    in property <[string]> connection-details;
    // Taking Cross-Com out of the game.
    in-out property <bool> confirming;
    in property <string> restore-said;
    in property <bool> restore-failed;
    callback options-changed();
    // The identity as text, to copy ("" when there's none to copy).
    callback identity-export() -> string;
    // Uses the identity pasted; `true` once replacing a different one is confirmed.
    callback identity-use(bool);
    // To Setup with the community test network chosen (true), or another server.
    callback change-server(bool);
    callback send-logs-now();
    callback open-logs();
    callback restore();
    callback test-connection();

    ScrollView {
        VerticalLayout {
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 30px;
            padding-bottom: 28px;
            spacing: 0px;
            alignment: start;

            Caps { text: "SETTINGS"; color: Theme.accent; }
            Text {
                text: "SETTINGS";
                font-family: Type.cond;
                font-weight: 700;
                font-size: 40px;
                color: Theme.fg;
                accessible-role: AccessibleRole.text;
            }

            HorizontalLayout {
                padding-top: 18px;
                spacing: 14px;
                // The game, its logs and its files.
                VerticalLayout {
                    spacing: 14px;
                    // Two equal columns, between the page's sides (40 px) and the gap.
                    width: (root.width - 94px) / 2;
                    alignment: start;
                    Card {
                        min-height: gl.preferred-height;
                        gl := VerticalLayout {
                            padding: 18px;
                            padding-left: 20px;
                            spacing: 8px;
                            CardHead { title: "Game"; }
                            Check { text: "Skip the intro videos"; checked <=> root.skip-intro; toggled => { root.options-changed(); } }
                            Check { text: "Use DirectX 9 (for older graphics cards)"; checked <=> root.dx9; toggled => { root.options-changed(); } }
                            Check { text: "In-game overlay"; checked <=> root.overlay; toggled => { root.options-changed(); } }
                            HorizontalLayout {
                                padding-left: 28px;
                                spacing: 10px;
                                alignment: start;
                                opacity: root.overlay ? 1 : 0.5;
                                Text { text: "Opens with"; color: Theme.soft; vertical-alignment: center; }
                                Choice {
                                    label: "The key that opens the overlay";
                                    model: ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"];
                                    current <=> root.overlay-key;
                                    enabled: root.overlay;
                                    chosen => { root.options-changed(); }
                                }
                            }
                            if root.options-said != "": Text {
                                text: root.options-said;
                                color: root.options-failed ? Theme.bad : Theme.muted;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Card {
                        min-height: ll.preferred-height;
                        ll := VerticalLayout {
                            padding: 18px;
                            padding-left: 20px;
                            spacing: 10px;
                            CardHead { title: "Logs"; }
                            Check {
                                text: "Send game logs to the server after each game (helps fix problems; your Windows user name and the game's sign-in token are removed)";
                                checked <=> root.send-logs;
                                toggled => { root.options-changed(); }
                            }
                            Text { text: root.logs-last; color: Theme.soft; font-size: Type.small; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Btn {
                                    text: "Send logs now";
                                    busy: root.logs-sending;
                                    enabled: root.send-logs && root.info.game-dir != "" && !root.logs-sending;
                                    clicked => { root.send-logs-now(); }
                                }
                                Btn { text: "Open logs folder"; enabled: root.info.game-dir != ""; clicked => { root.open-logs(); } }
                            }
                            if root.logs-said != "": Text { text: root.logs-said; color: Theme.muted; font-size: Type.small; wrap: word-wrap; }
                            Text {
                                text: "The server only takes logs from a PC its account has played online from in the last day. They help whoever runs it see what went wrong; each game's log stays in the game's logs folder.";
                                color: Theme.muted;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Card {
                        min-height: fl.preferred-height;
                        fl := VerticalLayout {
                            padding: 18px;
                            padding-left: 20px;
                            spacing: 10px;
                            CardHead { title: "The game's files"; }
                            Text {
                                text: root.info.game-dir != "" ? root.info.game-dir : "No game set up.";
                                font-family: Type.mono;
                                font-size: 12.5px;
                                color: Theme.soft;
                                wrap: char-wrap;
                            }
                            Para { text: "Cross-Com replaces two of the game's files and keeps the originals. Putting them back leaves the game as it was installed."; }
                            if !root.confirming: HorizontalLayout {
                                alignment: start;
                                Btn {
                                    text: "Restore the game's own files";
                                    enabled: root.info.game-dir != "" && root.info.client != "no";
                                    clicked => { root.confirming = true; }
                                }
                            }
                            if root.confirming: HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Btn { text: "Restore them"; kind: "primary"; clicked => { root.confirming = false; root.restore(); } }
                                Btn { text: "Keep Cross-Com"; clicked => { root.confirming = false; } }
                            }
                            if root.restore-said != "": Para { text: root.restore-said; color: root.restore-failed ? Theme.bad : Theme.soft; }
                        }
                    }
                }
                // The server and the account.
                VerticalLayout {
                    spacing: 14px;
                    // Two equal columns, between the page's sides (40 px) and the gap.
                    width: (root.width - 94px) / 2;
                    alignment: start;
                    Card {
                        min-height: al.preferred-height;
                        al := VerticalLayout {
                            padding: 18px;
                            padding-left: 20px;
                            spacing: 10px;
                            CardHead { title: "Server and account"; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: root.info.server != "" ? root.info.server : "No server set up";
                                    color: Theme.fg;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                if root.info.community: VerticalLayout { alignment: center; Tag { text: root.community-name; } }
                                if root.info.community && root.community-status != "": VerticalLayout { alignment: center; Tag { text: root.community-status; tint: Theme.warn; } }
                            }
                            Text {
                                text: root.info.account != "" ? "Signed in as " + root.info.account + "." : "No account here yet: Setup makes one.";
                                color: Theme.soft;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Btn { text: "Change server"; clicked => { root.change-server(false); } }
                                if !root.info.community: Btn { text: "Use the " + root.community-name.to-lowercase(); kind: "ghost"; clicked => { root.change-server(true); } }
                            }
                            // The identity that signs the player in: no password.
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: "Your identity"; color: Theme.soft; vertical-alignment: center; }
                                if root.identity != "": Text {
                                    text: root.identity;
                                    font-family: Type.mono;
                                    font-size: 14px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                }
                            }
                            if root.identity-error != "": Para { text: root.identity-error; color: Theme.bad; }
                            Para {
                                text: "It signs you in to your accounts, so there's no password. The launcher keeps it on this PC. Whoever has it can sign in as you: keep the copy private.";
                                font-size: Type.small;
                            }
                            HorizontalLayout {
                                alignment: start;
                                // The copy goes through a hidden text field, to Slint's own clipboard.
                                clip := TextInput { width: 0px; height: 0px; visible: false; read-only: true; single-line: true; }
                                Btn {
                                    text: "Copy to move it to another PC";
                                    enabled: root.identity != "" && !root.identity-busy;
                                    clicked => {
                                        clip.text = root.identity-export();
                                        clip.select-all();
                                        clip.copy();
                                        clip.text = "";
                                    }
                                }
                            }
                            Caps { text: "USE AN IDENTITY FROM ANOTHER PC"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Field {
                                    text <=> root.identity-paste;
                                    label: "The identity copied on another PC";
                                    placeholder: "Paste it here";
                                    secret: true;
                                    enabled: !root.identity-busy && root.identity-confirm == "";
                                    accepted => { if root.identity-paste != "" { root.identity-use(false); } }
                                }
                                Btn {
                                    text: "Use";
                                    busy: root.identity-busy;
                                    enabled: root.identity-paste != "" && !root.identity-busy && root.identity-confirm == "";
                                    clicked => { root.identity-use(false); }
                                }
                            }
                            if root.identity-confirm != "": Rectangle {
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.warn;
                                background: Theme.warn.with-alpha(0.06);
                                min-height: rl.preferred-height;
                                rl := VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text { text: root.identity-confirm; color: Theme.soft; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Btn { text: "Replace it"; kind: "primary"; clicked => { root.identity-confirm = ""; root.identity-use(true); } }
                                        Btn { text: "Keep mine"; clicked => { root.identity-confirm = ""; } }
                                    }
                                }
                            }
                            if root.identity-said != "": Text {
                                text: root.identity-said;
                                color: root.identity-failed ? Theme.bad : Theme.good;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Card {
                        min-height: cl.preferred-height;
                        cl := VerticalLayout {
                            padding: 18px;
                            padding-left: 20px;
                            spacing: 10px;
                            CardHead { title: "Connection"; }
                            Para { text: "How well other players can reach your game, from the server you've set up. It takes a few seconds."; }
                            HorizontalLayout {
                                alignment: start;
                                Btn {
                                    text: "Test my connection";
                                    busy: root.connection-testing;
                                    enabled: root.info.server != "" && root.info.game-dir != "" && !root.connection-testing;
                                    clicked => { root.test-connection(); }
                                }
                            }
                            if root.connection-summary != "": Text {
                                text: root.connection-summary;
                                color: root.connection-tone == "good" ? Theme.good : root.connection-tone == "bad" ? Theme.bad : Theme.warn;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            for line in root.connection-details: Text {
                                text: line;
                                color: Theme.soft;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                            Check {
                                text: "Ask my router to forward the game's port while it runs (UPnP, PCP or NAT-PMP), so other players reach me directly";
                                checked <=> root.port-forwarding;
                                toggled => { root.options-changed(); }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                padding-top: 18px;
                Text {
                    text: "Cross-Com Enhanced " + root.release + " · an open-source community server for Ghost Recon: Future Soldier. The launcher is made with Slint.";
                    color: Theme.muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
        }
    }
}
