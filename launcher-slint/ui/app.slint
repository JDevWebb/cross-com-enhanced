// The launcher's window: its own title bar, the side menu, the screen chosen and the status bar
// under it. Until the game, a server and an account are set up (the first launch), the guided
// setup is the screen, and Play is locked; Settings stays open.

import "../../assets/fonts/IBMPlexSans-Regular.ttf";
import "../../assets/fonts/IBMPlexSans-SemiBold.ttf";
import "../../assets/fonts/IBMPlexSansCondensed-Bold.ttf";
import "../../assets/fonts/IBMPlexMono-Regular.ttf";

import { Theme, Type } from "theme.slint";
import { CrossMark } from "brand.slint";
import { Spinner } from "widgets.slint";
import { TitleBar, SideMenu, Toast, Notice, UpdateBar, StatusBar } from "chrome.slint";
import { PlayScreen } from "play.slint";
import { SetupScreen } from "setup.slint";
import { SettingsScreen } from "settings.slint";
import { HostScreen } from "host.slint";
import { InfoView, NewsRow, DlcRow, CheckRow, CodeRow, ProfileRow } from "types.slint";

export { Theme, InfoView, NewsRow, DlcRow, CodeRow, ProfileRow }

export component AppWindow inherits Window {
    title: "Cross-Com Enhanced";
    icon: @image-url("../../docs/logo.svg");
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 940px;
    min-height: 600px;
    no-frame: true;
    background: Theme.bg;
    default-font-family: Type.sans;
    default-font-size: Type.body;

    in property <string> release;
    in property <bool> maximised;
    // "play", "setup" (run again, from Settings › About), "settings" or "host". Play needs
    // everything set up: until then it's the setup.
    in-out property <string> screen: "play";
    out property <string> shown: !info.ready && screen != "settings" && screen != "host" ? "setup" : screen;
    // Play's side panel ("status" or "news"), and the section Settings shows.
    in-out property <string> play-tab: "status";
    in-out property <string> settings-section: "game";
    // The first look at the game is in.
    in property <bool> loaded;
    in property <InfoView> info;
    in property <string> community-host;
    in property <string> community-name;
    // Beside its name while it isn't open yet (say "Launching soon"), or "".
    in property <string> community-status;
    // What the launcher just did, for a few seconds.
    in property <string> toast;
    // A notice over everything until it's answered ("" for none): before Windows' permission
    // prompt, what it's for. `notice-for` says what Continue goes on with.
    in property <string> notice-title;
    in property <string> notice-body;
    in property <string> notice-for;
    // A newer launcher ("" for none), and installing it: "offer", "updating" or "failed" (with
    // why); `playing` while the game runs.
    in property <string> update-version;
    in property <string> update-state;
    in property <string> update-said;
    in property <bool> playing;
    // About's Check for updates: looking, and what it found.
    in property <bool> update-checking;
    in property <string> update-checked;

    // Play.
    in property <string> server-state: "asking";
    in property <string> server-detail;
    in property <[NewsRow]> news;
    in property <string> news-note;
    in property <bool> news-loading;
    in property <[CheckRow]> checks;
    in property <bool> starting;
    in property <string> play-said;
    in property <bool> play-failed;

    // Setup.
    in-out property <string> setup-game-dir;
    in property <bool> setup-game-finding;
    in property <string> setup-game-error;
    // The DLC packs in the folder chosen, and the warning about them ("" when all are there).
    in property <[DlcRow]> setup-dlc;
    in property <string> setup-dlc-note;
    in-out property <bool> setup-community: true;
    in-out property <string> setup-server-typed;
    in property <string> setup-server-ok;
    in property <bool> setup-server-checking;
    in property <string> setup-server-error;
    // The account the player's identity has on the server checked ("" for none), or a new one's
    // name and sign-up code.
    in property <string> setup-account;
    in-out property <string> setup-name;
    in-out property <string> setup-code;
    in-out property <bool> setup-skip-intro: true;
    in-out property <bool> setup-dx9;
    in-out property <bool> setup-overlay: true;
    in-out property <bool> setup-send-logs: true;
    in-out property <bool> setup-port-forwarding: true;
    // The server chosen, as the launcher will use it (Settings › Server compares it with the one
    // set up).
    in property <string> setup-host;
    in property <bool> setup-account-done;
    in property <string> setup-missing;
    in property <bool> setup-busy;
    in property <string> setup-error;
    // The step Setup shows, and (on its last) why Windows will ask for permission, or "".
    in-out property <int> setup-step;
    in property <string> setup-firewall-note;

    // Settings: moving the game's folder and switching server (Setup's work, run from there).
    in property <string> moved-said;
    in property <bool> moved-failed;
    in property <string> switch-said;
    in property <bool> switch-failed;
    in-out property <bool> opt-skip-intro;
    in-out property <bool> opt-dx9;
    in-out property <bool> opt-overlay;
    in-out property <int> opt-overlay-key;
    in-out property <bool> opt-send-logs;
    in-out property <bool> opt-port-forwarding;
    // The fewest players a Quick Match starts with, as an index from 2.
    in-out property <int> opt-min-players;
    // The connection test: running, its verdict ("good", "warn" or "bad" for its colour) and
    // what it found.
    in property <bool> conn-testing;
    in property <string> conn-summary;
    in property <string> conn-tone;
    in property <[string]> conn-details;
    in property <string> options-said;
    in property <bool> options-failed;
    // The player's identity (see SettingsScreen).
    in property <string> id-short;
    in property <string> id-error;
    in-out property <string> id-paste;
    in-out property <string> id-confirm;
    in property <bool> id-busy;
    in property <string> id-said;
    in property <bool> id-failed;
    in property <string> logs-last;
    in property <string> logs-said;
    in property <bool> logs-sending;
    in-out property <bool> restore-confirming;
    in property <string> restore-said;
    in property <bool> restore-failed;
    // Settings › Saves.
    in property <[ProfileRow]> profiles;
    in property <string> saves-said;
    in property <bool> saves-failed;
    in property <bool> saves-busy;

    // Host.
    in property <string> host-state: "stopped";
    in property <string> host-said;
    in property <int> host-players;
    in property <[CheckRow]> host-lines;
    in property <[CodeRow]> host-codes;
    in property <[string]> host-log;
    in property <bool> host-plays-here;
    in property <bool> host-play-busy;
    in property <string> host-play-said;
    in property <bool> host-play-failed;
    in property <bool> host-carries-server: true;
    in-out property <bool> host-internet;

    // The window.
    callback drag();
    callback minimise();
    callback maximise();
    callback close-window();
    callback go(string);
    // Play.
    callback play();
    callback refresh-news();
    callback check-action(string);
    // Setup.
    callback setup-choose-game();
    callback setup-check-server();
    callback setup-changed();
    callback setup-run();
    callback setup-step-entered(int);
    // Settings.
    callback options-changed();
    callback identity-export() -> string;
    callback identity-use(bool);
    callback send-logs-now();
    callback open-logs();
    callback restore();
    callback test-connection();
    callback move-game();
    callback switch-server();
    // The notice: go on (with `notice-for`), or not.
    callback notice-proceed(string);
    callback notice-cancel(string);
    // About: one of its links, by id.
    callback open-link(string);
    // The launcher's updates.
    callback update-now();
    callback update-notes();
    callback update-later();
    callback check-update();
    // Host.
    callback host-start();
    callback host-stop();
    callback host-play-here();
    callback host-copied(string);
    callback host-access(bool);
    // Settings › Saves.
    callback saves-backup();
    callback saves-restore();
    callback saves-open();
    callback saves-use(string);

    VerticalLayout {
        TitleBar {
            release: root.release;
            maximised: root.maximised;
            drag => { root.drag(); }
            minimise => { root.minimise(); }
            maximise => { root.maximise(); }
            close => { root.close-window(); }
        }
        if root.update-version != "": UpdateBar {
            version: root.update-version;
            state: root.update-state;
            said: root.update-said;
            playing: root.playing;
            update => { root.update-now(); }
            notes => { root.update-notes(); }
            later => { root.update-later(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            SideMenu {
                current: root.shown;
                news: root.play-tab == "news";
                locked: root.shown == "setup";
                release: root.release;
                go(s) => {
                    if s == "news" {
                        root.play-tab = "news";
                        root.go("play");
                    } else {
                        if s == "play" { root.play-tab = "status"; }
                        root.go(s);
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Rectangle {
                    vertical-stretch: 1;
                    if root.loaded && root.shown == "play": PlayScreen {
                        info: root.info;
                        community-name: root.community-name;
                        community-status: root.community-status;
                        identity: root.id-short;
                        server-state: root.server-state;
                        server-detail: root.server-detail;
                        news: root.news;
                        news-note: root.news-note;
                        news-loading: root.news-loading;
                        checks: root.checks;
                        starting: root.starting;
                        tab <=> root.play-tab;
                        play => { root.play(); }
                        refresh => { root.refresh-news(); }
                        check-action(label) => { root.check-action(label); }
                        settings(section) => {
                            root.settings-section = section;
                            root.go("settings");
                        }
                    }
                    if root.loaded && root.shown == "setup": SetupScreen {
                        first: !root.info.ready;
                        community-host: root.community-host;
                        community-name: root.community-name;
                        community-status: root.community-status;
                        game-dir: root.setup-game-dir;
                        game-finding: root.setup-game-finding;
                        game-error: root.setup-game-error;
                        dlc: root.setup-dlc;
                        dlc-note: root.setup-dlc-note;
                        community <=> root.setup-community;
                        server-typed <=> root.setup-server-typed;
                        server-ok: root.setup-server-ok;
                        server-checking: root.setup-server-checking;
                        server-error: root.setup-server-error;
                        account: root.setup-account;
                        name <=> root.setup-name;
                        code <=> root.setup-code;
                        skip-intro <=> root.setup-skip-intro;
                        dx9 <=> root.setup-dx9;
                        overlay <=> root.setup-overlay;
                        send-logs <=> root.setup-send-logs;
                        port-forwarding <=> root.setup-port-forwarding;
                        account-done: root.setup-account-done;
                        missing: root.setup-missing;
                        busy: root.setup-busy;
                        error: root.setup-error;
                        step <=> root.setup-step;
                        firewall-note: root.setup-firewall-note;
                        step-entered(n) => { root.setup-step-entered(n); }
                        choose-game => { root.setup-choose-game(); }
                        check-server => { root.setup-check-server(); }
                        changed => { root.setup-changed(); }
                        run => { root.setup-run(); }
                        cancel => {
                            root.settings-section = "about";
                            root.go("settings");
                        }
                    }
                    if root.loaded && root.shown == "settings": SettingsScreen {
                        info: root.info;
                        release: root.release;
                        community-host: root.community-host;
                        community-name: root.community-name;
                        community-status: root.community-status;
                        section <=> root.settings-section;
                        skip-intro <=> root.opt-skip-intro;
                        dx9 <=> root.opt-dx9;
                        overlay <=> root.opt-overlay;
                        overlay-key <=> root.opt-overlay-key;
                        send-logs <=> root.opt-send-logs;
                        port-forwarding <=> root.opt-port-forwarding;
                        min-players <=> root.opt-min-players;
                        options-said: root.options-said;
                        options-failed: root.options-failed;
                        busy: root.setup-busy;
                        moved-said: root.moved-said;
                        moved-failed: root.moved-failed;
                        community <=> root.setup-community;
                        server-typed <=> root.setup-server-typed;
                        server-chosen: root.setup-host;
                        server-ok: root.setup-server-ok;
                        server-checking: root.setup-server-checking;
                        server-error: root.setup-server-error;
                        account: root.setup-account;
                        name <=> root.setup-name;
                        code <=> root.setup-code;
                        account-done: root.setup-account-done;
                        switch-said: root.switch-said;
                        switch-failed: root.switch-failed;
                        connection-testing: root.conn-testing;
                        connection-summary: root.conn-summary;
                        connection-tone: root.conn-tone;
                        connection-details: root.conn-details;
                        identity: root.id-short;
                        identity-error: root.id-error;
                        identity-paste <=> root.id-paste;
                        identity-confirm <=> root.id-confirm;
                        identity-busy: root.id-busy;
                        identity-said: root.id-said;
                        identity-failed: root.id-failed;
                        logs-last: root.logs-last;
                        logs-said: root.logs-said;
                        logs-sending: root.logs-sending;
                        confirming <=> root.restore-confirming;
                        restore-said: root.restore-said;
                        restore-failed: root.restore-failed;
                        update-checking: root.update-checking;
                        update-checked: root.update-checked;
                        profiles: root.profiles;
                        saves-said: root.saves-said;
                        saves-failed: root.saves-failed;
                        saves-busy: root.saves-busy;
                        playing: root.playing;
                        saves-backup => { root.saves-backup(); }
                        saves-restore => { root.saves-restore(); }
                        saves-open => { root.saves-open(); }
                        saves-use(account) => { root.saves-use(account); }
                        options-changed => { root.options-changed(); }
                        move-game => { root.move-game(); }
                        check-server => { root.setup-check-server(); }
                        server-changed => { root.setup-changed(); }
                        switch-server => { root.switch-server(); }
                        identity-export => { return root.identity-export(); }
                        identity-use(confirmed) => { root.identity-use(confirmed); }
                        send-logs-now => { root.send-logs-now(); }
                        open-logs => { root.open-logs(); }
                        restore => { root.restore(); }
                        test-connection => { root.test-connection(); }
                        check-update => { root.check-update(); }
                        open-link(id) => { root.open-link(id); }
                        run-setup => { root.go("setup"); }
                    }
                    if root.loaded && root.shown == "host": HostScreen {
                        state: root.host-state;
                        said: root.host-said;
                        players: root.host-players;
                        lines: root.host-lines;
                        codes: root.host-codes;
                        log: root.host-log;
                        game-ready: root.info.ready;
                        plays-here: root.host-plays-here;
                        play-busy: root.host-play-busy;
                        play-said: root.host-play-said;
                        play-failed: root.host-play-failed;
                        carries-server: root.host-carries-server;
                        internet <=> root.host-internet;
                        access-changed(on) => { root.host-access(on); }
                        start-server => { root.host-start(); }
                        stop-server => { root.host-stop(); }
                        play-here => { root.host-play-here(); }
                        copied(place) => { root.host-copied(place); }
                    }
                    if !root.loaded: VerticalLayout {
                        alignment: center;
                        spacing: 18px;
                        HorizontalLayout { alignment: center; CrossMark { size: 96px; glow: true; } }
                        HorizontalLayout { alignment: center; Spinner { size: 18px; } }
                    }
                    if root.toast != "": Toast {
                        text: root.toast;
                        x: parent.width - self.width - 22px;
                        y: parent.height - self.height - 22px;
                    }
                    if root.notice-title != "": Notice {
                        title: root.notice-title;
                        body: root.notice-body;
                        proceed => { root.notice-proceed(root.notice-for); }
                        cancel => { root.notice-cancel(root.notice-for); }
                    }
                }
                if root.loaded: StatusBar {
                    text: root.shown == "host" ? (root.host-state == "running" ? "Hosting: " + root.host-players + " online on your server." : root.host-state == "starting" ? "Starting your server…" : root.host-state == "failed" ? "Your server stopped." : "Your server isn't running.")
                        : root.shown == "setup" ? (root.info.ready ? "Setting up again: nothing changes until you press Set up." : "Not set up yet: step " + (root.setup-step + 1) + " of 5.")
                        : !root.info.ready ? "Not set up: Play opens the setup."
                        : root.starting ? "Starting the game…"
                        : root.play-said != "" ? root.play-said
                        : root.setup-busy ? "Setting up…"
                        : root.logs-sending ? "Sending the game's logs…"
                        : root.server-state == "down" ? "The server didn't answer: " + root.server-detail
                        : root.server-state == "asking" ? "Asking " + root.info.server + "…"
                        : "Signed in to " + root.info.server + " as " + root.info.account;
                    tone: root.shown == "host" ? (root.host-state == "running" ? "good" : root.host-state == "starting" ? "busy" : root.host-state == "failed" ? "bad" : "warn")
                        : root.shown == "setup" || !root.info.ready ? "warn"
                        : root.starting || root.setup-busy || root.logs-sending || (root.play-said == "" && root.server-state == "asking") ? "busy"
                        : root.play-said != "" ? (root.play-failed ? "bad" : "good")
                        : root.server-state == "down" ? "bad"
                        : "good";
                }
            }
        }
    }

    // The window's edge, when it isn't maximised.
    if !root.maximised: Rectangle {
        border-width: 1px;
        border-color: Theme.control-line;
    }
}
