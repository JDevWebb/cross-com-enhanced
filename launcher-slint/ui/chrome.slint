// The window round the screens: its own title bar (the mark, the name, the release, the window's
// buttons), the side menu, and the note that comes up after something's done.

import { Theme, Type } from "theme.slint";
import { CrossMark } from "brand.slint";

// The menu's icons (24 by 24, stroked).
export global Icons {
    out property <string> play: "M7 4.5v15l12-7.5z";
    out property <string> setup: "M4 7h10 M4 17h6 M18 7h2 M14 17h6 M18 7a2 2 0 1 1-4 0a2 2 0 1 1 4 0z M14 17a2 2 0 1 1-4 0a2 2 0 1 1 4 0z";
    out property <string> settings: "M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z M12 3v3 M12 18v3 M3 12h3 M18 12h3 M5.6 5.6l2.1 2.1 M16.3 16.3l2.1 2.1 M5.6 18.4l2.1-2.1 M16.3 7.7l2.1-2.1";
    out property <string> refresh: "M20 12a8 8 0 1 1-2.3-5.6 M20 4v4.5h-4.5";
}

export component Icon inherits Path {
    in property <length> size: 20px;
    in property <color> color: Theme.muted;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
}

// A window button in the title bar.
component WindowButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> closer: false;
    callback clicked();
    width: 46px;
    background: ta.has-hover ? (closer ? Theme.bad : Theme.control-hover) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    Path {
        width: 11px;
        height: 11px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: glyph;
        stroke: ta.has-hover && closer ? Theme.on-bad : ta.has-hover ? Theme.fg : Theme.soft;
        stroke-width: 1.2px;
        fill: transparent;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> release;
    in property <bool> maximised: false;
    callback drag();
    callback minimise();
    callback maximise();
    callback close();
    height: 34px;
    background: Theme.rail;

    // The bar is where the window is dragged from, and double-clicked to maximise.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag();
            }
        }
        double-clicked => { root.maximise(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        VerticalLayout { alignment: center; CrossMark { size: 16px; tile: false; } }
        Text {
            text: "CROSS-COM ENHANCED";
            vertical-alignment: center;
            font-family: Type.mono;
            font-size: 11px;
            letter-spacing: 1.3px;
            color: Theme.muted;
        }
        Text {
            text: root.release;
            vertical-alignment: center;
            font-family: Type.mono;
            font-size: 11px;
            letter-spacing: 1.3px;
            color: Theme.accent;
            opacity: 0.8;
        }
        Rectangle { horizontal-stretch: 1; }
        WindowButton { label: "Minimise"; glyph: "M1 6.5h10"; clicked => { root.minimise(); } }
        WindowButton {
            label: maximised ? "Restore" : "Maximise";
            glyph: maximised ? "M3.5 1.5h7v7 M1.5 3.5h7v7h-7z" : "M1.5 1.5h9v9h-9z";
            clicked => { root.maximise(); }
        }
        WindowButton { label: "Close"; glyph: "M1.5 1.5l9 9 M10.5 1.5l-9 9"; closer: true; clicked => { root.close(); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// One entry of the side menu: its icon and its name under it.
component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    callback clicked();
    forward-focus: fs;
    width: 60px;
    height: 54px;
    border-radius: 8px;
    background: on ? Theme.selected : ta.has-hover ? Theme.control : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: label;
    accessible-checked: on;
    accessible-action-default => { clicked(); }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    // The current screen: the accent edge.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: on ? parent.height - 20px : 0px;
        background: Theme.accent;
        border-radius: 1px;
        animate height { duration: Theme.calm; easing: ease-out; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon { commands: root.icon; color: on ? Theme.accent : ta.has-hover ? Theme.fg : Theme.muted; }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 10.5px;
            color: on ? Theme.accent : ta.has-hover ? Theme.fg : Theme.muted;
        }
    }
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 10px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
}

export component SideMenu inherits Rectangle {
    in property <string> current;
    callback go(string);
    width: 76px;
    background: Theme.rail;
    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout { alignment: center; MenuItem { label: "Play"; icon: Icons.play; on: current == "play"; clicked => { root.go("play"); } } }
        HorizontalLayout { alignment: center; MenuItem { label: "Set up"; icon: Icons.setup; on: current == "setup"; clicked => { root.go("setup"); } } }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { alignment: center; MenuItem { label: "Settings"; icon: Icons.settings; on: current == "settings"; clicked => { root.go("settings"); } } }
    }
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
}

// What the launcher just did, for a few seconds in the corner.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <length> widest: 460px;
    width: min(widest, t.preferred-width + 40px);
    height: t.preferred-height + 24px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.accent-dim;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000080;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    Rectangle { x: 0; width: 3px; background: Theme.accent; border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
    t := Text {
        x: 20px;
        width: parent.width - 36px;
        text: root.text;
        wrap: word-wrap;
        color: Theme.fg;
    }
}
