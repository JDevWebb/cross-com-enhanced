// The window round the screens: its own title bar (the mark, the name, the release, the window's
// buttons), the side menu, the status bar along the bottom, and the note that comes up after
// something's done.

import { Theme, Type } from "theme.slint";
import { CrossMark } from "brand.slint";
import { Btn, Spinner } from "widgets.slint";

// The menu's icons (24 by 24, stroked).
export global Icons {
    out property <string> play: "M7 4.5v15l12-7.5z";
    out property <string> news: "M5 4h14v16H5z M8.5 9h7 M8.5 13h7 M8.5 17h4";
    out property <string> settings: "M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z M12 3v3 M12 18v3 M3 12h3 M18 12h3 M5.6 5.6l2.1 2.1 M16.3 16.3l2.1 2.1 M5.6 18.4l2.1-2.1 M16.3 7.7l2.1-2.1";
    out property <string> refresh: "M20 12a8 8 0 1 1-2.3-5.6 M20 4v4.5h-4.5";
    out property <string> about: "M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0z M12 11v6 M12 7.5v.01";
}

export component Icon inherits Path {
    in property <length> size: 20px;
    in property <color> color: Theme.muted;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
}

// A window button in the title bar.
component WindowButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> closer: false;
    callback clicked();
    width: 46px;
    background: ta.has-hover ? (closer ? Theme.bad : Theme.control-hover) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    Path {
        width: 11px;
        height: 11px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: glyph;
        stroke: ta.has-hover && closer ? Theme.on-bad : ta.has-hover ? Theme.fg : Theme.soft;
        stroke-width: 1.2px;
        fill: transparent;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> release;
    in property <bool> maximised: false;
    callback drag();
    callback minimise();
    callback maximise();
    callback close();
    height: 34px;
    background: Theme.rail;

    // The bar is where the window is dragged from, and double-clicked to maximise.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag();
            }
        }
        double-clicked => { root.maximise(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        VerticalLayout { alignment: center; CrossMark { size: 16px; tile: false; } }
        Text {
            text: "CROSS-COM ENHANCED";
            vertical-alignment: center;
            font-family: Type.mono;
            font-size: 11px;
            letter-spacing: 1.3px;
            color: Theme.muted;
        }
        Text {
            text: root.release;
            vertical-alignment: center;
            font-family: Type.mono;
            font-size: 11px;
            letter-spacing: 1.3px;
            color: Theme.accent;
            opacity: 0.8;
        }
        Rectangle { horizontal-stretch: 1; }
        WindowButton { label: "Minimise"; glyph: "M1 6.5h10"; clicked => { root.minimise(); } }
        WindowButton {
            label: maximised ? "Restore" : "Maximise";
            glyph: maximised ? "M3.5 1.5h7v7 M1.5 3.5h7v7h-7z" : "M1.5 1.5h9v9h-9z";
            clicked => { root.maximise(); }
        }
        WindowButton { label: "Close"; glyph: "M1.5 1.5l9 9 M10.5 1.5l-9 9"; closer: true; clicked => { root.close(); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// One entry of the side menu: its icon and its name under it.
component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    // Locked while the first setup shows (Play and News need everything set up).
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: fs;
    width: 60px;
    height: 54px;
    border-radius: 8px;
    opacity: enabled ? 1 : 0.35;
    background: on ? Theme.selected : ta.has-hover && enabled ? Theme.control : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: label;
    accessible-checked: on;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    // The current screen: the accent edge.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: on ? parent.height - 20px : 0px;
        background: Theme.accent;
        border-radius: 1px;
        animate height { duration: Theme.calm; easing: ease-out; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon { commands: root.icon; color: on ? Theme.accent : ta.has-hover ? Theme.fg : Theme.muted; }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 10.5px;
            color: on ? Theme.accent : ta.has-hover ? Theme.fg : Theme.muted;
        }
    }
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 10px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
}

// The side menu: the mark, Play and its News, and Settings at the foot with the release under it.
// While the first setup shows, Play and News are locked.
export component SideMenu inherits Rectangle {
    in property <string> current;
    // Play's side panel shows its news (News lights up instead of Play).
    in property <bool> news;
    in property <bool> locked;
    in property <string> release;
    callback go(string);
    width: 80px;
    background: Theme.rail;
    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout { alignment: center; padding-bottom: 10px; CrossMark { size: 40px; } }
        HorizontalLayout { alignment: center; MenuItem { label: "Play"; icon: Icons.play; enabled: !root.locked; on: current == "play" && !root.news; clicked => { root.go("play"); } } }
        HorizontalLayout { alignment: center; MenuItem { label: "News"; icon: Icons.news; enabled: !root.locked; on: current == "play" && root.news; clicked => { root.go("news"); } } }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { alignment: center; MenuItem { label: "Settings"; icon: Icons.settings; on: current == "settings"; clicked => { root.go("settings"); } } }
        Text {
            text: root.release;
            horizontal-alignment: center;
            font-family: Type.mono;
            font-size: 10.5px;
            color: Theme.muted;
            overflow: elide;
        }
    }
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
}

// What the launcher just did, for a few seconds in the corner.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <length> widest: 460px;
    width: min(widest, t.preferred-width + 40px);
    height: t.preferred-height + 24px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.accent-dim;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000080;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    Rectangle { x: 0; width: 3px; background: Theme.accent; border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
    t := Text {
        x: 20px;
        width: parent.width - 36px;
        text: root.text;
        wrap: word-wrap;
        color: Theme.fg;
    }
}

// Before Windows' permission prompt: what it is, why it comes, and what to click. Over the whole
// window, until Continue or Cancel.
export component Notice inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> go: "Continue";
    callback proceed();
    callback cancel();
    background: #000000a0;
    // Clicks outside the card do nothing (the screen behind waits).
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancel(); return accept; }
            if e.text == Key.Return { root.proceed(); return accept; }
            reject
        }
    }
    card := Rectangle {
        width: min(560px, root.width - 64px);
        height: lay.preferred-height;
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.accent-dim;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000a0;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: root.title;
        lay := VerticalLayout {
            padding: 26px;
            spacing: 14px;
            Text {
                text: root.title;
                font-family: Type.cond;
                font-weight: 700;
                font-size: 24px;
                color: Theme.fg;
                wrap: word-wrap;
            }
            Text { text: root.body; color: Theme.soft; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 10px;
                alignment: end;
                Btn { text: "Cancel"; clicked => { root.cancel(); } }
                Btn { text: root.go; kind: "primary"; clicked => { root.proceed(); } }
            }
        }
    }
}

// Under the title bar, on every screen: a newer launcher, and installing it. `state` is "offer",
// "updating" or "failed" (`said` says why).
export component UpdateBar inherits Rectangle {
    in property <string> version;
    in property <string> state;
    in property <string> said;
    // The game is running: the launcher waits for it (to send its log) before replacing itself.
    in property <bool> playing;
    callback update();
    callback notes();
    callback later();
    background: root.state == "failed" ? Theme.bad.with-alpha(0.12) : Theme.accent-glow;
    border-width: 1px;
    border-color: root.state == "failed" ? Theme.bad.with-alpha(0.4) : Theme.accent-dim;
    min-height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        if root.state == "updating": VerticalLayout { alignment: center; Spinner { size: 14px; } }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
            color: root.state == "failed" ? Theme.bad : Theme.fg;
            text: root.state == "updating" ? "Downloading launcher " + root.version + ": it restarts when it's ready."
                : root.state == "failed" ? "Couldn't update the launcher: " + root.said
                : root.playing ? "Launcher " + root.version + " is available: update once the game has closed."
                : "Launcher " + root.version + " is available, with the client to match.";
        }
        if root.state != "updating": Btn { text: "What's new"; kind: "ghost"; clicked => { root.notes(); } }
        if root.state != "updating": Btn {
            text: root.state == "failed" ? "Try again" : "Update";
            kind: "primary";
            enabled: !root.playing;
            clicked => { root.update(); }
        }
        if root.state != "updating": Btn { text: "Later"; kind: "ghost"; clicked => { root.later(); } }
    }
}

// Along the window's foot: how things stand in one line (signed in, the game starting, what went
// wrong), with its dot. `tone` is "good", "warn", "bad" or "busy".
export component StatusBar inherits Rectangle {
    in property <string> text;
    in property <string> tone: "good";
    height: 40px;
    background: Theme.rail;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    Rectangle { y: 0; height: 1px; background: Theme.accent-dim; }
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 20px;
        spacing: 12px;
        if root.tone == "busy": VerticalLayout { alignment: center; Spinner { size: 12px; } }
        if root.tone != "busy": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.tone == "good" ? Theme.good : root.tone == "bad" ? Theme.bad : Theme.warn;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.tone == "bad" ? Theme.bad : Theme.fg;
            font-size: 14px;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}
