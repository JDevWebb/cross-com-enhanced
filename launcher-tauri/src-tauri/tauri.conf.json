{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cross-Com Enhanced",
  "version": "0.1.0",
  "identifier": "com.crosscom-enhanced.launcher",
  "build": { "frontendDist": "../ui/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cross-Com Enhanced",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 580,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
